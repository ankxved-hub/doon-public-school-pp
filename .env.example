# Environment variables for third-party integrations (managed via AI Studio Secrets panel).
# Firebase AI Logic (Gemini) uses App Check attestation and requires no API key.
# Optional: Paste your deployed Cloudflare Worker URL (e.g. https://doon-school-eta.yourname.workers.dev)
# in AI Studio Secrets as CLOUDFLARE_API_URL to sync Android & Website on Cloudflare D1.
CLOUDFLARE_API_URL=

