        allow update: if isMember() && isValidId(docId) &&
          incoming().ownerUid == existing().ownerUid &&
          isValidTimestampsUpdate() &&
          isValidCraftProject(incoming()) &&
          (
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
              incoming().likesCount == existing().likesCount + 1 &&
              !exists(craftLikePath(docId + '__' + memberUserDocId())) &&
              existsAfter(craftLikePath(docId + '__' + memberUserDocId()))
            ) ||
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
              existing().likesCount > 0 &&
              incoming().likesCount == existing().likesCount - 1 &&
              exists(craftLikePath(docId + '__' + memberUserDocId())) &&
              !existsAfter(craftLikePath(docId + '__' + memberUserDocId()))
            ) ||
