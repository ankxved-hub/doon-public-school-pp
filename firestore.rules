rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function isValidTimestampsCreate() {
      return incoming().createdAt is timestamp &&
             incoming().createdAt <= request.time &&
             incoming().updatedAt is timestamp &&
             incoming().updatedAt <= request.time;
    }

    function isValidTimestampsUpdate() {
      return incoming().createdAt == existing().createdAt &&
             incoming().updatedAt is timestamp &&
             incoming().updatedAt <= request.time;
    }

    function isValidSchoolUser(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.role in ['ADMIN', 'TEACHER', 'FEE_MANAGER', 'STUDENT'] &&
             data.userId is string && data.userId.size() >= 2 && data.userId.size() <= 40 &&
             data.password is string && data.password.size() >= 1 && data.password.size() <= 64 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.wing is string && data.wing.size() <= 50 &&
             data.className is string && data.className.size() <= 30 &&
             data.section is string && data.section.size() <= 10 &&
             data.subject is string && data.subject.size() <= 60 &&
             data.parentName is string && data.parentName.size() <= 100 &&
             data.monthlyTuition is int && data.monthlyTuition >= 0 &&
             data.transportFee is int && data.transportFee >= 0;
    }

    function isValidGatewayConfig(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.merchantUpi is string && data.merchantUpi.size() >= 1 && data.merchantUpi.size() <= 100 &&
             data.payeeName is string && data.payeeName.size() >= 1 && data.payeeName.size() <= 100 &&
             data.bankName is string && data.bankName.size() <= 120 &&
             data.accountNo is string && data.accountNo.size() <= 40 &&
             data.ifsc is string && data.ifsc.size() <= 20 &&
             data.razorpayKeyId is string && data.razorpayKeyId.size() <= 80;
    }

    function isValidCircular(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.audience is string && data.audience.size() >= 1 && data.audience.size() <= 120 &&
             data.get('targetWing', '') is string && data.get('targetWing', '').size() <= 60 &&
             data.get('targetClass', '') is string && data.get('targetClass', '').size() <= 30 &&
             data.get('targetSection', '') is string && data.get('targetSection', '').size() <= 10 &&
             data.date is string && data.date.size() >= 1 && data.date.size() <= 20 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
             data.postedBy is string && data.postedBy.size() >= 1 && data.postedBy.size() <= 100 &&
             data.get('recipientDocId', '') is string && data.get('recipientDocId', '').size() <= 128 &&
             data.get('recipientName', '') is string && data.get('recipientName', '').size() <= 120 &&
             data.get('senderRole', 'ADMIN') in ['ADMIN', 'TEACHER'] &&
             data.get('attachmentName', '') is string && data.get('attachmentName', '').size() <= 160 &&
             data.get('attachmentMimeType', '') is string && data.get('attachmentMimeType', '').size() <= 120 &&
             data.get('attachmentData', '') is string && data.get('attachmentData', '').size() <= 450000;
    }

    function isValidDptDaily(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.date is string && data.date.size() >= 1 && data.date.size() <= 20 &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 30 &&
             data.section is string && data.section.size() >= 1 && data.section.size() <= 10 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60 &&
             data.get('assessmentType', 'DPT') in ['DPT', 'EXAM'] &&
             data.held is bool &&
             data.topic is string && data.topic.size() <= 200 &&
             data.maxMarks is int && data.maxMarks >= 0 && data.maxMarks <= 100 &&
             data.notes is string && data.notes.size() <= 1000 &&
             data.reason is string && data.reason.size() <= 200 &&
             data.get('attachmentName', '') is string && data.get('attachmentName', '').size() <= 160 &&
             data.get('attachmentMimeType', '') is string && data.get('attachmentMimeType', '').size() <= 120 &&
             data.get('attachmentData', '') is string && data.get('attachmentData', '').size() <= 450000 &&
             data.teacherId is string && data.teacherId.size() >= 1 && data.teacherId.size() <= 40 &&
             data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 100;
    }

    function isValidDptWeekly(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.week is string && data.week.size() >= 1 && data.week.size() <= 50 &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 30 &&
             data.section is string && data.section.size() >= 1 && data.section.size() <= 10 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60 &&
             data.studentDocId is string && data.studentDocId.size() >= 1 && data.studentDocId.size() <= 128 &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
             data.admissionNo is string && data.admissionNo.size() >= 1 && data.admissionNo.size() <= 40 &&
             data.scored is int && data.scored >= 0 &&
             data.maxMarks is int && data.maxMarks >= 1 &&
             data.teacherId is string && data.teacherId.size() >= 1 && data.teacherId.size() <= 40;
    }

    function isValidAttendance(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.date is string && data.date.size() >= 1 && data.date.size() <= 20 &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 30 &&
             data.section is string && data.section.size() >= 1 && data.section.size() <= 10 &&
             data.studentDocId is string && data.studentDocId.size() >= 1 && data.studentDocId.size() <= 128 &&
             data.status in ['Present', 'Absent', 'Leave'] &&
             data.markedBy is string && data.markedBy.size() >= 1 && data.markedBy.size() <= 40;
    }

    function isValidLeave(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.studentDocId is string && data.studentDocId.size() >= 1 && data.studentDocId.size() <= 128 &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
             data.admissionNo is string && data.admissionNo.size() >= 1 && data.admissionNo.size() <= 40 &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 30 &&
             data.section is string && data.section.size() >= 1 && data.section.size() <= 10 &&
             data.fromDate is string && data.fromDate.size() >= 1 && data.fromDate.size() <= 20 &&
             data.toDate is string && data.toDate.size() >= 1 && data.toDate.size() <= 20 &&
             data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500 &&
             data.status in ['Pending', 'Approved', 'Rejected'] &&
             data.teacherRemark is string && data.teacherRemark.size() <= 300;
    }

    function isValidHomework(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 30 &&
             data.section is string && data.section.size() >= 1 && data.section.size() <= 10 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 1500 &&
             data.dueDate is string && data.dueDate.size() >= 1 && data.dueDate.size() <= 20 &&
             data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 100;
    }

    function isValidTermMark(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.term is string && data.term.size() >= 1 && data.term.size() <= 60 &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 30 &&
             data.section is string && data.section.size() >= 1 && data.section.size() <= 10 &&
             data.studentDocId is string && data.studentDocId.size() >= 1 && data.studentDocId.size() <= 128 &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
             data.admissionNo is string && data.admissionNo.size() >= 1 && data.admissionNo.size() <= 40 &&
             data.marks is map &&
             data.remarks is string && data.remarks.size() <= 500 &&
             data.publishedBy is string && data.publishedBy.size() >= 1 && data.publishedBy.size() <= 100;
    }

    function isValidFeeItem(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.studentDocId is string && data.studentDocId.size() >= 1 && data.studentDocId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.month is string && data.month.size() >= 1 && data.month.size() <= 40 &&
             data.amount is int && data.amount >= 0 &&
             data.status in ['UNPAID', 'PENDING_VERIFICATION', 'PAID'] &&
             data.paymentId is string && data.paymentId.size() <= 128;
    }

    function isValidFeePayment(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.studentDocId is string && data.studentDocId.size() >= 1 && data.studentDocId.size() <= 128 &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
             data.admissionNo is string && data.admissionNo.size() >= 1 && data.admissionNo.size() <= 40 &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 40 &&
             data.feeItemIds is list && data.feeItemIds.size() <= 30 &&
             (data.feeItemIds.size() == 0 || data.feeItemIds[0] is string) &&
             data.feeSummary is string && data.feeSummary.size() >= 1 && data.feeSummary.size() <= 500 &&
             data.amount is int && data.amount > 0 &&
             data.mode in ['UPI', 'RAZORPAY'] &&
             data.utrOrRef is string && data.utrOrRef.size() >= 1 && data.utrOrRef.size() <= 80 &&
             data.upiApp is string && data.upiApp.size() <= 50 &&
             data.status in ['PENDING', 'VERIFIED', 'REJECTED'] &&
             data.receiptNo is string && data.receiptNo.size() <= 60 &&
             data.rejectReason is string && data.rejectReason.size() <= 300 &&
             data.verifiedBy is string && data.verifiedBy.size() <= 100 &&
             data.verifiedAtStr is string && data.verifiedAtStr.size() <= 60;
    }

    function isValidDoubt(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.studentDocId is string && data.studentDocId.size() >= 1 && data.studentDocId.size() <= 128 &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 40 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
             data.reply is string && data.reply.size() <= 1000 &&
             data.repliedBy is string && data.repliedBy.size() <= 100 &&
             data.status in ['OPEN', 'REPLIED'] &&
             data.dateLabel is string && data.dateLabel.size() >= 1 && data.dateLabel.size() <= 20;
    }

    function isValidCraftProject(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 1500 &&
             data.materials is string && data.materials.size() <= 500 &&
             data.authorDocId is string && data.authorDocId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
             data.authorUserId is string && data.authorUserId.size() <= 40 &&
             data.authorRole in ['STUDENT', 'TEACHER', 'ADMIN'] &&
             data.classInfo is string && data.classInfo.size() <= 80 &&
             data.dateLabel is string && data.dateLabel.size() >= 1 && data.dateLabel.size() <= 20 &&
             data.aiImageData is string && data.aiImageData.size() <= 460000 &&
             data.aiPromptUsed is string && data.aiPromptUsed.size() <= 600 &&
             data.likesCount is int && data.likesCount >= 0;
    }

    function isValidCraftLike(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 &&
             data.likerId is string && data.likerId.size() >= 1 && data.likerId.size() <= 128;
    }

    function isValidCampusPoster(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.subtitle is string && data.subtitle.size() <= 180 &&
             data.date is string && data.date.size() >= 1 && data.date.size() <= 30 &&
             data.imageData is string && data.imageData.size() >= 1 && data.imageData.size() <= 460000 &&
             data.postedBy is string && data.postedBy.size() >= 1 && data.postedBy.size() <= 100;
    }

    function isValidTimetable(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 30 &&
             data.section is string && data.section.size() >= 1 && data.section.size() <= 10 &&
             data.slots is list && data.slots.size() >= 1 && data.slots.size() <= 16 &&
             data.slots[0] is map &&
             data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 100;
    }

    function isValidLoginTicket(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.schoolUserDocId is string && data.schoolUserDocId.size() >= 1 && data.schoolUserDocId.size() <= 128 &&
             data.role in ['ADMIN', 'TEACHER', 'FEE_MANAGER', 'STUDENT'] &&
             data.userId is string && data.userId.size() >= 2 && data.userId.size() <= 40 &&
             data.className is string && data.className.size() <= 30 &&
             data.section is string && data.section.size() <= 10;
    }

    // Legacy per-account path kept strictly read-only for owner during one-time migration
    match /accounts/{ownerUid}/{colName}/{docId} {
      allow list: if isOwner(ownerUid);
      allow get: if isValidId(docId) && isOwner(ownerUid);
      allow write: if false;
    }

    // Shared multi-device school cloud database
    match /schools/{schoolId} {
      function memberPath(uid) {
        return /databases/$(database)/documents/schools/$(schoolId)/members/$(uid);
      }

      function loginTicketPath(ticketId) {
        return /databases/$(database)/documents/schools/$(schoolId)/loginIndex/$(ticketId);
      }

      function userDocPath(docId) {
        return /databases/$(database)/documents/schools/$(schoolId)/users/$(docId);
      }

      function craftProjectPath(projId) {
        return /databases/$(database)/documents/schools/$(schoolId)/craftProjects/$(projId);
      }

      function craftLikePath(likeDocId) {
        return /databases/$(database)/documents/schools/$(schoolId)/craftLikes/$(likeDocId);
      }

      function isSchoolInitialized() {
        return exists(/databases/$(database)/documents/schools/$(schoolId));
      }

      function isBootstrappingBatch() {
        return isSignedIn() &&
               !isSchoolInitialized() &&
               existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
               incoming().ownerUid == request.auth.uid;
      }

      function isMember() {
        return isSignedIn() && exists(memberPath(request.auth.uid));
      }

      function memberData() {
        return get(memberPath(request.auth.uid)).data;
      }

      function memberRole() {
        return memberData().role;
      }

      function memberUserDocId() {
        return memberData().schoolUserDocId;
      }

      function isAdmin() {
        return isMember() && memberRole() == 'ADMIN';
      }

      function isTeacher() {
        return isMember() && memberRole() == 'TEACHER';
      }

      function isFeeManager() {
        return isMember() && memberRole() == 'FEE_MANAGER';
      }

      function teacherOwnsClassSection(cls, sec) {
        return isTeacher() &&
               cls is string && cls.size() > 0 &&
               sec is string && sec.size() > 0 &&
               exists(userDocPath(memberUserDocId())) &&
               get(userDocPath(memberUserDocId())).data.className == cls &&
               get(userDocPath(memberUserDocId())).data.section == sec;
      }

      allow get: if isSignedIn() && isValidId(schoolId);
      allow list: if false;
      allow create: if isSignedIn() && isValidId(schoolId) &&
        !isSchoolInitialized() &&
        incoming().ownerUid == request.auth.uid &&
        incoming().keys().hasAll(['ownerUid', 'name', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['ownerUid', 'name', 'createdAt', 'updatedAt']) &&
        isValidTimestampsCreate() &&
        incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 120;
      allow update, delete: if false;

      match /members/{authUid} {
        allow list: if false;
        allow get: if isOwner(authUid) && isValidId(authUid);
        allow create: if isOwner(authUid) && isValidId(authUid) &&
          incoming().ownerUid == authUid &&
          incoming().keys().hasAll(['ownerUid', 'schoolUserDocId', 'role', 'loginTicketId', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['ownerUid', 'schoolUserDocId', 'role', 'loginTicketId', 'createdAt', 'updatedAt']) &&
          isValidTimestampsCreate() &&
          incoming().role in ['ADMIN', 'TEACHER', 'FEE_MANAGER', 'STUDENT'] &&
          isValidId(incoming().schoolUserDocId) &&
          isValidId(incoming().loginTicketId) &&
          existsAfter(loginTicketPath(incoming().loginTicketId)) &&
          getAfter(loginTicketPath(incoming().loginTicketId)).data.schoolUserDocId == incoming().schoolUserDocId &&
          getAfter(loginTicketPath(incoming().loginTicketId)).data.role == incoming().role;
        allow update: if isOwner(authUid) && isValidId(authUid) &&
          incoming().ownerUid == existing().ownerUid &&
          isValidTimestampsUpdate() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['schoolUserDocId', 'role', 'loginTicketId', 'updatedAt']) &&
          incoming().role in ['ADMIN', 'TEACHER', 'FEE_MANAGER', 'STUDENT'] &&
          isValidId(incoming().schoolUserDocId) &&
          isValidId(incoming().loginTicketId) &&
          existsAfter(loginTicketPath(incoming().loginTicketId)) &&
          getAfter(loginTicketPath(incoming().loginTicketId)).data.schoolUserDocId == incoming().schoolUserDocId &&
          getAfter(loginTicketPath(incoming().loginTicketId)).data.role == incoming().role;
        allow delete: if isOwner(authUid) && isValidId(authUid);
      }

      match /loginIndex/{ticketId} {
        allow list: if false;
        allow get: if isSignedIn() && isValidId(ticketId);
        allow create: if isSignedIn() && isValidId(ticketId) &&
          incoming().ownerUid == request.auth.uid &&
          incoming().keys().hasAll(['ownerUid', 'schoolUserDocId', 'role', 'userId', 'className', 'section', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['ownerUid', 'schoolUserDocId', 'role', 'userId', 'className', 'section', 'createdAt', 'updatedAt']) &&
          isValidTimestampsCreate() &&
          isValidLoginTicket(incoming()) &&
          (
            isBootstrappingBatch() ||
            isAdmin() ||
            (teacherOwnsClassSection(incoming().className, incoming().section) && incoming().role == 'STUDENT') ||
            (isMember() && incoming().schoolUserDocId == memberUserDocId() && incoming().role == memberRole())
          );
        allow update: if isSignedIn() && isValidId(ticketId) &&
          isValidTimestampsUpdate() &&
          isValidLoginTicket(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['ownerUid', 'schoolUserDocId', 'role', 'userId', 'className', 'section', 'updatedAt']) &&
          (
            isAdmin() ||
            (teacherOwnsClassSection(incoming().className, incoming().section) && incoming().role == 'STUDENT') ||
            (isMember() && existing().schoolUserDocId == memberUserDocId() && incoming().schoolUserDocId == existing().schoolUserDocId && incoming().role == existing().role)
          );
        allow delete: if isSignedIn() && isValidId(ticketId) &&
          (
            isAdmin() ||
            (teacherOwnsClassSection(existing().className, existing().section) && existing().role == 'STUDENT') ||
            (isMember() && existing().schoolUserDocId == memberUserDocId())
          );
      }

      match /users/{docId} {
        allow list: if isMember();
        allow get: if isValidId(docId) && isMember();
        allow create: if isSignedIn() && isValidId(docId) &&
          incoming().ownerUid == request.auth.uid &&
          incoming().keys().hasAll(['ownerUid', 'role', 'userId', 'password', 'fullName', 'phone', 'wing', 'className', 'section', 'subject', 'parentName', 'monthlyTuition', 'transportFee', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['ownerUid', 'role', 'userId', 'password', 'fullName', 'phone', 'wing', 'className', 'section', 'subject', 'parentName', 'monthlyTuition', 'transportFee', 'createdAt', 'updatedAt']) &&
          isValidTimestampsCreate() &&
          isValidSchoolUser(incoming()) &&
          (
            isBootstrappingBatch() ||
            isAdmin() ||
            (teacherOwnsClassSection(incoming().className, incoming().section) && incoming().role == 'STUDENT')
          );
        allow update: if isMember() && isValidId(docId) &&
          incoming().ownerUid == existing().ownerUid &&
          isValidTimestampsUpdate() &&
          isValidSchoolUser(incoming()) &&
          (
            (docId == memberUserDocId() &&
              incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'password', 'updatedAt'])) ||
            (isAdmin() &&
              incoming().diff(existing()).affectedKeys().hasOnly(['role', 'userId', 'password', 'fullName', 'phone', 'wing', 'className', 'section', 'subject', 'parentName', 'monthlyTuition', 'transportFee', 'updatedAt'])) ||
            (teacherOwnsClassSection(existing().className, existing().section) &&
              existing().role == 'STUDENT' &&
              incoming().role == 'STUDENT' &&
              incoming().className == existing().className &&
              incoming().section == existing().section &&
              incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'password', 'fullName', 'phone', 'wing', 'className', 'section', 'subject', 'parentName', 'monthlyTuition', 'transportFee', 'updatedAt']))
          );
        allow delete: if isValidId(docId) &&
          (
            isAdmin() ||
            (teacherOwnsClassSection(existing().className, existing().section) && existing().role == 'STUDENT')
          );
      }

      match /gatewayConfig/{docId} {
        allow list: if isMember();
        allow get: if isValidId(docId) && isMember();
        allow create: if isSignedIn() && isValidId(docId) &&
          incoming().ownerUid == request.auth.uid &&
          incoming().keys().hasAll(['ownerUid', 'merchantUpi', 'payeeName', 'bankName', 'accountNo', 'ifsc', 'razorpayKeyId', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['ownerUid', 'merchantUpi', 'payeeName', 'bankName', 'accountNo', 'ifsc', 'razorpayKeyId', 'createdAt', 'updatedAt']) &&
          isValidTimestampsCreate() &&
          isValidGatewayConfig(incoming()) &&
          (isBootstrappingBatch() || isAdmin() || isFeeManager());
        allow update: if isValidId(docId) &&
          (isAdmin() || isFeeManager()) &&
          incoming().ownerUid == existing().ownerUid &&
          isValidTimestampsUpdate() &&
          isValidGatewayConfig(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['merchantUpi', 'payeeName', 'bankName', 'accountNo', 'ifsc', 'razorpayKeyId', 'updatedAt']);
